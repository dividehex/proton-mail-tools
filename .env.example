# Bearer token OpenWebUI must send. Generate with: openssl rand -hex 32
PROTON_TOOLS_API_KEY=replace-me

# Proton Mail Bridge account credentials (Bridge app > Mailbox configuration).
# Username is your Proton email address; password is the Bridge-generated one, not your Proton password.
PROTON_BRIDGE_USERNAME=you@proton.me
PROTON_BRIDGE_PASSWORD=replace-me

# Optional: address/name to send from (defaults to the bridge username with no display name).
PROTON_MAIL_FROM_ADDRESS=
PROTON_MAIL_FROM_NAME=

# Optional capability gates.
PROTON_TOOLS_ALLOW_SEND=true
PROTON_TOOLS_ALLOW_DELETE=true
# Permanent deletion in Spam/Trash (delete_messages, empty_mailbox). Irreversible; off by default.
PROTON_TOOLS_ALLOW_PURGE=false

# Only when migrating an existing desktop Bridge (see docs/migrate-desktop-bridge.md):
# the desktop user's home directory, so the vault's absolute paths resolve in the container.
# Leave empty for a fresh login (defaults to /root).
PROTON_BRIDGE_HOME=
